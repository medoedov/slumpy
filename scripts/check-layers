#!/usr/bin/env bash
# Fails when a core agent-system file holds a listed platform or project term.
# The core files are the ones named in the first sentence of .claude/rules/core-process.md; every
# .claude/rules/core-*.md file must be named there. Only the frontmatter `paths` list is skipped
# (globs are set per project); the rest must be English. The term list catches known details only.
set -euo pipefail
export LC_ALL=C.UTF-8
cd "$(dirname "$0")/.."

PROCESS=.claude/rules/core-process.md
status=0

# Core files from the first sentence of core-process.md ("This file, ... are the core").
sentence=$(awk 'NR>1 && NF {print}' "$PROCESS" | tr '\n' ' ' | sed 's/ are the core.*//')
CORE=("$PROCESS")
for name in $(grep -o '`[^`]*`' <<<"$sentence" | tr -d '`'); do
  if   [ -f ".claude/rules/$name" ];            then CORE+=(".claude/rules/$name")
  elif [ -f ".claude/agents/$name.md" ];        then CORE+=(".claude/agents/$name.md")
  elif [ -f ".claude/skills/$name/SKILL.md" ];  then CORE+=(".claude/skills/$name/SKILL.md")
  else echo "core-process.md names a core file that does not exist: $name"; status=1
  fi
done
for f in .claude/rules/core-*.md; do
  printf '%s\n' "${CORE[@]}" | grep -qx -- "$f" || { echo "core file not named in core-process.md: $f"; status=1; }
done

# Platform and project terms that belong in the platform pack or the project layer.
TERMS='\bswift(\b|ui|data)|\bios\b|ipados|macos|iphone|ipad|apple|xcode|testflight|app store|app review'
TERMS+='|app group|keychain|entitlement|sendable|mainactor|actor isolation|\barc\b|uikit|widgetkit'
TERMS+='|storekit|cloudkit|healthkit|userdefaults|deviceactivity|family ?controls|screen time'
TERMS+='|liquid glass|dynamic type|voiceover|privacy manifest|app transport security|\bats\b|\bhig\b'
TERMS+='|apns|required-reason|logic package|adr-[0-9]|scripts/check([^-]|$)|\.env\b|`main`|`dev`'
TERMS+='|kindle|slumpy|mvp\.md|russian|duolingo'

for f in "${CORE[@]}"; do
  # Drop only the frontmatter `paths:` key and its list items; descriptions are core text.
  body=$(awk 'NR==1 && /^---$/ {fm=1; next} fm && /^---$/ {fm=0; next}
              fm && /^paths:/ {inpaths=1; next} fm && inpaths && /^  *- / {next}
              {inpaths=0; print}' "$f")
  hits=$(printf '%s\n' "$body" | grep -n -i -E "$TERMS" || true)
  cyr=$(printf '%s\n' "$body" | grep -n -P '[\x{0400}-\x{04FF}]' || true)
  if [ -n "$hits$cyr" ]; then
    echo "== $f"
    [ -n "$hits" ] && printf '%s\n' "$hits"
    [ -n "$cyr" ] && printf 'non-English text:\n%s\n' "$cyr"
    status=1
  fi
done

[ "$status" -eq 0 ] && echo "check-layers: ${#CORE[@]} core files clean"
exit "$status"
