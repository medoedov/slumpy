#!/usr/bin/env python3
"""Fails when a change touches risky paths or text without written evidence.

The change set is everything since the merge base with origin/dev (or dev), plus uncommitted and
untracked files. Rules come from scripts/risk-paths. Evidence lives in files the same change set
touches: an ADR under docs/decisions/, or a work/*/plan.md line. Any error exits non-zero.
"""
import fnmatch, pathlib, re, subprocess, sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
RULES = ROOT / "scripts/risk-paths"


def git(*args):
    return subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True,
                          check=True).stdout


def base():
    for ref in ("origin/dev", "dev"):
        try:
            return git("merge-base", "HEAD", ref).strip()
        except subprocess.CalledProcessError:
            continue
    return "HEAD"


def changed(b):
    names = set(git("diff", "--name-only", b).split())          # committed and staged and unstaged
    names |= set(git("ls-files", "--others", "--exclude-standard").split())
    return sorted(n for n in names if (ROOT / n).is_file())


def added_lines(b, name):
    if name in git("ls-files", "--others", "--exclude-standard").split():
        return (ROOT / name).read_text(encoding="utf-8", errors="replace").splitlines()
    diff = git("diff", "-U0", b, "--", name)
    return [l[1:] for l in diff.splitlines() if l.startswith("+") and not l.startswith("+++")]


def match(name, glob):
    return fnmatch.fnmatch(name, glob) or (glob.startswith("**/") and fnmatch.fnmatch(name, glob[3:]))


rules = []
for line in RULES.read_text(encoding="utf-8").splitlines():
    line = line.strip()
    if line and not line.startswith("#"):
        category, pattern = line.split(None, 1)
        rules.append((category, re.compile(pattern) if category.endswith("-text") else pattern))

b = base()
files = changed(b)
plans = [f for f in files if re.fullmatch(r"work/[^/]+/plan\.md", f)]
plan_text = "\n".join((ROOT / p).read_text(encoding="utf-8") for p in plans)
adr_changed = any(re.fullmatch(r"docs/decisions/\d{4}-.+\.md", f) for f in files)

needs = {"t2": [], "security": []}
for f in files:
    if f.startswith(("scripts/", ".claude/", "docs/", "work/", "evals/")) or f.endswith(".md"):
        continue  # the agent system and its records are not app code
    for category, pattern in rules:
        kind = category.removesuffix("-text")
        if category.endswith("-text"):
            if any(pattern.search(l) for l in added_lines(b, f)):
                needs[kind].append(f)
        elif match(f, pattern):
            needs[kind].append(f)

problems = []
if needs["t2"] and not (adr_changed or re.search(r"T1 because", plan_text)):
    problems.append("risky change without an ADR in docs/decisions/ or a 'T1 because' line in a "
                    "changed work/*/plan.md: " + ", ".join(sorted(set(needs["t2"]))))
if needs["security"] and not re.search(r"security pass", plan_text, re.IGNORECASE):
    problems.append("security-pass trigger without a 'security pass' line in a changed "
                    "work/*/plan.md: " + ", ".join(sorted(set(needs["security"]))))

if problems:
    print("\n".join(problems))
    sys.exit(1)
print(f"check-risk: {len(files)} changed files, evidence present where needed")
