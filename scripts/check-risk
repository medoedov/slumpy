#!/usr/bin/env python3
"""Fails when a change touches risky paths or text without evidence written in the same change.

Rules and the evidence format: scripts/risk-paths, header. The change set is everything since the
merge base with origin/dev (or dev), plus uncommitted and untracked files, deleted files included.
If the base cannot be determined, or any git call fails, the check fails: it never reports success
on input it could not read.
"""
import fnmatch, pathlib, re, subprocess, sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
RULES = ROOT / "scripts/risk-paths"
SKIP_PREFIXES = ("scripts/", ".claude/", "docs/", "work/", "evals/")  # the agent system and records


def git(*args):
    return subprocess.run(["git", "-c", "core.quotePath=false", *args], cwd=ROOT,
                          capture_output=True, text=True, check=True).stdout


def base():
    for ref in ("origin/dev", "dev"):
        try:
            return git("merge-base", "HEAD", ref).strip()
        except subprocess.CalledProcessError:
            continue
    raise SystemExit("check-risk: no merge base with origin/dev or dev; "
                     "run `git fetch origin dev` (and `git fetch --unshallow` in a shallow clone)")


def names(*args):
    return [n for n in git(*args, "-z").split("\0") if n]


def added_lines_by_file(b):
    """Lines each file adds against the base, one git call for tracked files."""
    out, current = {}, None
    for line in git("diff", "-U0", "--no-color", "--no-ext-diff", "--no-renames", b).splitlines():
        m = re.match(r'^\+\+\+ (?:b/(.*?)\t?|/dev/null)$', line)
        if m:
            current = m.group(1)
            if current and current.startswith('"'):
                current = None  # quoted names are resolved below through -z listings
            out.setdefault(current, [])
        elif line.startswith("+") and not line.startswith("+++") and current is not None:
            out[current].append(line[1:])
    return out


def match(name, glob):
    return fnmatch.fnmatch(name, glob) or (glob.startswith("**/") and fnmatch.fnmatch(name, glob[3:]))


def main():
    rules = []
    for line in RULES.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            category, pattern = line.split(None, 1)
            rules.append((category, re.compile(pattern) if category.endswith("-text") else pattern))

    b = base()
    tracked = names("diff", "--name-only", "--no-renames", b)
    untracked = names("ls-files", "--others", "--exclude-standard")
    added_new_adrs = set(names("diff", "--name-only", "--no-renames", "--diff-filter=A", b))
    files = sorted(set(tracked) | set(untracked))

    added = added_lines_by_file(b)
    for f in files:
        if f in untracked:
            added[f] = (ROOT / f).read_text(encoding="utf-8", errors="replace").splitlines()
        elif f not in added and (ROOT / f).is_file():
            # quoted or unusual names: read this file's diff alone
            diff = git("diff", "-U0", "--no-color", "--no-ext-diff", b, "--", f)
            added[f] = [l[1:] for l in diff.splitlines() if l.startswith("+") and not l.startswith("+++")]

    plan_added = [l for f in files if re.fullmatch(r"work/[^/]+/plan\.md", f) for l in added.get(f, [])]
    new_adr = any(re.fullmatch(r"docs/decisions/\d{4}-.+\.md", f)
                  for f in (added_new_adrs | set(untracked)))
    t1_line = any(re.match(r"\s*(-\s+)?T1 because\b", l) for l in plan_added)
    security_line = any(re.match(r"\s*(-\s+)?Security pass:", l) for l in plan_added)

    needs = {"t2": set(), "security": set()}
    for f in files:
        if f.startswith(SKIP_PREFIXES) or f.endswith(".md"):
            continue
        for category, pattern in rules:
            kind = category.removesuffix("-text")
            if category.endswith("-text"):
                if any(pattern.search(l) for l in added.get(f, [])):
                    needs[kind].add(f)
            elif match(f, pattern):
                needs[kind].add(f)

    problems = []
    if needs["t2"] and not (new_adr or t1_line):
        problems.append("T2 signal without a new ADR or an added 'T1 because' line in a "
                        "work/*/plan.md (scripts/risk-paths): " + ", ".join(sorted(needs["t2"])))
    if needs["security"] and not security_line:
        problems.append("security-pass trigger without an added 'Security pass:' line in a "
                        "work/*/plan.md (scripts/risk-paths): " + ", ".join(sorted(needs["security"])))
    if problems:
        print("\n".join(problems))
        return 1
    print(f"check-risk: {len(files)} changed files, evidence present where needed")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as e:
        sys.exit(f"check-risk: git failed: {' '.join(e.cmd)}: {e.stderr.strip()}")
