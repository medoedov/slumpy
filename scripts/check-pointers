#!/usr/bin/env python3
"""Fails when a pointer of the form `file.md`, Section (or «Section», "Section") names a section
that the file does not have. A section matches a heading, a bold label, or a line that starts with
its name. Dated records that cite past states are skipped (SKIP below)."""
import pathlib, re, subprocess, sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
FROZEN = ("AGENTS.md", ".agents/", ".codex/", ".githooks/", "evals/results/")
SKIP = {  # dated records: they describe the system as it was when written
    "work/agent-system-audit/verification.md",
}
QUOTED = r'(?:«[^»]+»|"[^"]+")'
POINTER = re.compile(
    r'`?([\w./-]+\.md)`?,?\s+\(?(?:section |раздел |разделы )?'
    r'(' + QUOTED + r'(?:\s*(?:и|and|,)\s*' + QUOTED + r')*'
    r'|(?:T\d|[A-Z][a-z]+)(?: [a-z]+){0,3}(?=\s*[;.,)|]|\s*$))'
)

files = [f for f in subprocess.run(["git", "ls-files", "*.md"], cwd=ROOT, capture_output=True,
                                   text=True, check=True).stdout.split()
         if not f.startswith(FROZEN)]
by_name = {}
for f in files:
    by_name.setdefault(pathlib.Path(f).name, []).append(f)

def sections(path):
    out = []
    for line in (ROOT / path).read_text(encoding="utf-8").splitlines():
        s = re.sub(r'^[#\s]*(?:\d+(?:\.\d+)*\.?\s*)?', '', line)
        s = s.lstrip('*-| ').casefold()
        out.append(s)
    return out

status = 0
for f in files:
    if f in SKIP:
        continue
    for n, line in enumerate((ROOT / f).read_text(encoding="utf-8").splitlines(), 1):
        for m in POINTER.finditer(line):
            name, target = m.group(1), m.group(2)
            names = re.findall(r'«([^»]+)»|"([^"]+)"', target)
            names = [a or b for a, b in names] or [target.strip()]
            candidates = by_name.get(pathlib.Path(name).name, [])
            if not candidates:
                continue  # not a repository file (e.g. a doc page name)
            for sec in names:
                key = sec.casefold()
                if not any(s.startswith(key) for c in candidates for s in sections(c)):
                    print(f"{f}:{n}: `{name}` has no section {sec!r}")
                    status = 1
if status == 0:
    print("check-pointers: all section pointers resolve")
sys.exit(status)
