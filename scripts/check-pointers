#!/usr/bin/env python3
"""Fails when a pointer of the form `file.md`, Section (or «Section», "Section") names a section
that the file does not have. A section matches a heading, a bold label, or a line that starts with
its name. A pointer with a path resolves by that path, from the repository root or from the
pointing file's folder, and fails when neither exists; a bare file name is checked against every
tracked file of that name. Dated records that cite past states are skipped (SKIP below)."""
import os, pathlib, re, subprocess, sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
FROZEN = ("AGENTS.md", ".agents/", ".codex/", ".githooks/", "evals/results/")
SKIP = {  # dated records: they describe the system as it was when written
    "work/agent-system-audit/verification.md",
}
QUOTED = r'(?:«[^»]+»|"[^"]+")'
POINTER = re.compile(
    r'`?([\w./-]+\.md)`?,?\s+\(?(?:section |раздел |разделы )?'
    r'(' + QUOTED + r'(?:\s*(?:и|and|,)\s*' + QUOTED + r')*'
    r'|(?:T\d|[A-Z][a-z]+)(?: [a-z]+){0,3}(?=\s*[;.,)|]|\s*$))'
)

# Tracked Markdown files that exist on disk; a git failure ends the run with an error.
try:
    listed = subprocess.run(["git", "-c", "core.quotePath=false", "ls-files", "-z", "*.md"],
                            cwd=ROOT, capture_output=True, text=True, check=True).stdout
except subprocess.CalledProcessError as e:
    sys.exit(f"check-pointers: git failed: {e.stderr.strip()}")
files = [f for f in listed.split("\0") if not f.startswith(FROZEN) and (ROOT / f).is_file()]
by_name = {}
for f in files:
    by_name.setdefault(pathlib.Path(f).name, []).append(f)

def sections(path):
    out = []
    for line in (ROOT / path).read_text(encoding="utf-8").splitlines():
        s = re.sub(r'^[#\s]*(?:\d+(?:\.\d+)*\.?\s*)?', '', line)
        s = s.lstrip('*-| ').casefold()
        out.append(s)
    return out

problems = []
for f in files:
    if f in SKIP:
        continue
    for n, line in enumerate((ROOT / f).read_text(encoding="utf-8").splitlines(), 1):
        for m in POINTER.finditer(line):
            name, target = m.group(1), m.group(2)
            names = re.findall(r'«([^»]+)»|"([^"]+)"', target)
            names = [a or b for a, b in names] or [target]
            if "/" in name:
                here = os.path.normpath(os.path.join(os.path.dirname(f), name))
                candidates = [p for p in dict.fromkeys((os.path.normpath(name), here))
                              if (ROOT / p).is_file()]
                if not candidates:
                    problems.append(f"{f}:{n}: `{name}` does not exist")
            else:
                candidates = by_name.get(name, [])
            if not candidates:
                continue  # a missing path, reported above, or not a repository file (a doc page)
            for sec in names:
                key = sec.casefold()
                if not any(s.startswith(key) for c in candidates for s in sections(c)):
                    problems.append(f"{f}:{n}: `{name}` has no section {sec!r}")
if problems:
    print("\n".join(problems))
    sys.exit(1)
print("check-pointers: all section pointers resolve")
