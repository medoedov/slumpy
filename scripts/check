#!/usr/bin/env python3
"""The project's single check command.

Runs the document checks and prints what ran and what did not. A check that cannot read its input
fails; nothing reports success on input it did not read. Build, tests, and lint are not wired in
yet (skeleton ADR). Verification levels and mutation scope: docs/agent-system.md.

--final requires SLUMPY_CHECK_BASE and a nonempty task range. The default is a local check.

--hook  Stop hook, with no record of its own. When the change set (`check-risk --changed`) is
        empty, report skipped checks and exit; otherwise run the checks. A
        failure keeps the session working through `additionalContext` (shown as hook feedback,
        not as a hook error); while the session is already continuing because of this hook, it
        shows the failures as a system message instead. A crash of the hook itself is a real
        error and blocks with a JSON decision. SLUMPY_TEST_HOOK_CRASH set makes the hook raise,
        for the self-test of that path. Overdue upkeep is a system-message reminder only;
        it never asks the agent to continue the current task.

--codex-hook uses the same checks with Codex Stop JSON: a scoped report on success, a block
        decision on the first failure, and a system message on a repeated Stop. Neither hook's
        bounded continuation is acceptance; a failed explicit check still exits nonzero.
        Each subprocess is limited to 45 seconds so the seven-call hook fits its 360-second budget.
        Hooks are feedback mechanisms; timed-out or crashed checks do not establish readiness.
"""
import json, os, pathlib, subprocess, sys, traceback

ROOT = pathlib.Path(__file__).resolve().parent.parent
CHECKS = ["check-layers", "check-pointers", "check-risk", "check-lessons", "check-upkeep", "check-state"]


def script(name, *args):
    command = [sys.executable, "-I", str(ROOT / "scripts" / name), *args]
    try:
        return subprocess.run(command, capture_output=True, text=True, timeout=45)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(command, 124, "", "unavailable: check timed out")
    except OSError as error:
        return subprocess.CompletedProcess(command, 127, "", "unavailable: " + str(error))


def run_checks():
    failed, report = [], []
    for name in CHECKS:
        p = script(name)
        out = (p.stdout + p.stderr).strip()
        last = out.splitlines()[-1] if out else ""
        ok = p.returncode == 0 and bool(out)
        if not out:
            out = "unavailable: check returned no report"
            last = out
        status, summary = ("ok" if ok else "FAIL"), last.removeprefix(name + ": ")
        if ok and summary.startswith("reminder:"):
            status = "note"
        report.append(f"[{status}] {name}: {summary}")
        if not ok:
            failed.append(f"{name}:\n{out}")
    report.append("[not run] build, tests, lint: not wired into scripts/check yet (skeleton ADR)")
    report.append("[not run] test-checks: on demand")
    return failed, report


def respond(reason, continuing, error=False, codex=False):
    if continuing:
        out = {"systemMessage": reason}
    elif error or codex:
        out = {"decision": "block", "reason": reason}
    else:
        out = {"hookSpecificOutput": {"hookEventName": "Stop", "additionalContext": reason}}
    print(json.dumps(out))


def hook(continuing, codex=False):
    if os.environ.get("SLUMPY_TEST_HOOK_CRASH"):
        raise Exception("crash requested by the self-test")
    changed = script("check-risk", "--changed")
    if changed.returncode == 0 and not changed.stdout:
        print(json.dumps({"systemMessage": "No changed files in the local comparison; checks skipped. "
                          "This is not task acceptance; use scripts/check --final with the task-start base."}))
        return 0  # no local input was checked; this is not acceptance
    failed, report = run_checks()
    if changed.returncode != 0:
        failed.insert(0, "change set: " + changed.stderr.strip())  # a failure prints to stderr only
    if failed:
        respond("scripts/check failed; fix before finishing:\n" + "\n".join(report) + "\n\n"
                + "\n\n".join(failed) + "\nUnresolved checks mean incomplete acceptance; report a blocker if they cannot run.", continuing, codex=codex)
    else:
        print(json.dumps({"systemMessage": "Document checks passed for the local comparison only. "
                          "Task acceptance requires scripts/check --final with the task-start base.\n"
                          + "\n".join(report)}))
    return 0


def run_hook(codex=False):
    continuing = False
    try:
        raw = sys.stdin.read()
        try:
            continuing = bool(json.loads(raw).get("stop_hook_active"))
        except json.JSONDecodeError:
            pass  # no input or not JSON: not continuing
        return hook(continuing, codex=codex)
    except Exception:
        respond("scripts/check --hook crashed:\n" + traceback.format_exc(), continuing, error=True, codex=codex)
        return 0


def main():
    if "--codex-hook" in sys.argv:
        return run_hook(codex=True)
    if "--hook" in sys.argv:
        return run_hook()
    if "--final" in sys.argv:
        if not os.environ.get("SLUMPY_CHECK_BASE"):
            print("[unavailable] final acceptance: SLUMPY_CHECK_BASE required (task-start commit)")
            return 1
        scope = script("check-risk", "--scope")
        if scope.returncode != 0:
            print("[unavailable] final acceptance: " + (scope.stdout + scope.stderr).strip())
            return 1
        try:
            details = json.loads(scope.stdout)
            print("[scope] " + json.dumps(details, sort_keys=True))
            if details["index_worktree_mismatch"]:
                print("[unavailable] final acceptance: index/worktree differ for staged paths; "
                      "align these snapshots or unstage before acceptance")
                return 1
            if not details["tracked"] and not details["untracked"]:
                print("[unavailable] final acceptance: empty change set; verify the task-start base")
                return 1
        except (ValueError, KeyError, TypeError):
            print("[unavailable] final acceptance: invalid change-set report")
            return 1
    else:
        print("[local] document checks only; use --final with SLUMPY_CHECK_BASE for task acceptance")
    failed, report = run_checks()
    print("\n".join(report))
    if failed:
        print("\n" + "\n\n".join(failed))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
