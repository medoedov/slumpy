#!/usr/bin/env python3
"""The project's single check command.

Runs the document checks and their self-test everywhere, and the build and tests where an Xcode
project exists. Prints what ran and what did not; exits non-zero when a check fails, and fails when
an Xcode project or package exists but build and tests are not wired in yet. Any check that cannot
read its input fails; it never reports success on input it did not read.

--hook: the Stop hook. It runs the checks only when the repository changed since its last run
(HEAD, the diff against HEAD, untracked files), so a turn that changed nothing is never blocked.
A failure blocks with a JSON decision on stdout; when the session is already continuing because of
this hook, or nothing changed since a failed run, it does not block again and shows the open
failures as a system message.
"""
import hashlib, json, os, pathlib, subprocess, sys, traceback

ROOT = pathlib.Path(__file__).resolve().parent.parent
CHECKS = ["check-layers", "check-pointers", "check-risk", "check-lessons", "test-checks"]
XCODE_MARKERS = ("*.xcodeproj/project.pbxproj", "Package.swift", "**/Package.swift", "project.yml")


def git(*args):
    return subprocess.run(["git", "-c", "core.quotePath=false", *args], cwd=ROOT,
                          capture_output=True, text=True, check=True).stdout


def run_checks():
    failed, report = [], []
    # Inside the self-test, the self-test itself is skipped: it would recurse.
    names = [c for c in CHECKS if not (c == "test-checks" and os.environ.get("SLUMPY_IN_TEST_CHECKS"))]
    for name in names:
        p = subprocess.run([sys.executable, "-I", str(ROOT / "scripts" / name)], cwd=ROOT,
                           capture_output=True, text=True)
        out = (p.stdout + p.stderr).strip()
        last = out.splitlines()[-1] if out else ""
        ok = p.returncode == 0
        report.append(f"[{'ok' if ok else 'FAIL'}] {name}: {last.removeprefix(name + ': ')}")
        if not ok:
            failed.append(f"{name}:\n{out}")
    project = [n for n in git("ls-files", "-z", "--cached", "--others", "--exclude-standard",
                              *XCODE_MARKERS).split("\0") if n]
    if project:
        report.append("[FAIL] build, tests, lint: an Xcode project or package exists ("
                      + ", ".join(project[:3]) + ") but scripts/check does not build it yet")
        failed.append("build: wire xcodebuild or swift build and test into scripts/check")
    else:
        report.append("[not run] build, tests, lint: no Xcode project or package yet")
    return failed, report


def state():
    h = hashlib.sha256()
    h.update(git("rev-parse", "HEAD").encode())
    h.update(git("diff", "HEAD", "--no-color", "--binary").encode())
    for n in [n for n in git("ls-files", "-z", "--others", "--exclude-standard").split("\0") if n]:
        h.update(n.encode())
        f = ROOT / n
        if f.is_file():
            h.update(f.read_bytes())
    return h.hexdigest()


def hook():
    payload = {}
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError):
        pass
    state_file = ROOT / git("rev-parse", "--git-path", "slumpy-check-state.json").strip()
    last = json.loads(state_file.read_text()) if state_file.is_file() else None
    now = state()
    clean = not git("status", "--porcelain").strip()

    if last is None and clean:
        state_file.write_text(json.dumps({"state": now, "failed": []}))
        return 0  # first stop in this clone with nothing changed: a chat-only turn
    if last and last["state"] == now:
        if last["failed"]:
            print(json.dumps({"systemMessage": "scripts/check still fails:\n"
                              + "\n\n".join(last["failed"])}))
        return 0

    failed, _ = run_checks()
    state_file.write_text(json.dumps({"state": now, "failed": failed}))
    if not failed:
        return 0
    reason = "scripts/check failed; fix before finishing:\n\n" + "\n\n".join(failed)
    if payload.get("stop_hook_active"):
        print(json.dumps({"systemMessage": reason}))
    else:
        print(json.dumps({"decision": "block", "reason": reason}))
    return 0


def main():
    if "--hook" in sys.argv:
        try:
            return hook()
        except Exception:
            print(json.dumps({"decision": "block",
                              "reason": "scripts/check --hook crashed:\n" + traceback.format_exc()}))
            return 0
    failed, report = run_checks()
    print("\n".join(report))
    if failed:
        print("\n" + "\n\n".join(failed))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
