def rule_lines():
    lines = (ROOT / "scripts/risk-paths").read_text(encoding="utf-8").splitlines()
    return sum(1 for l in lines if l.strip() and not l.lstrip().startswith("#"))


def all_cases():
    p = subprocess.run([sys.executable, "-I", str(ROOT / "scripts/check-risk"), "--rules"],
                       cwd=ROOT, capture_output=True, text=True)
    if p.returncode != 0:
        return None, [f"check-risk --rules failed: {(p.stdout + p.stderr).strip()}"]
    rules = json.loads(p.stdout)
    if len(rules) != rule_lines():
        return None, [f"check-risk --rules returned {len(rules)} rules for {rule_lines()} rule lines"]
    return STATIC + rule_cases(rules) + check_cases(), []


def run_cases():
    cases, failures = all_cases()
    if cases is None:
        return 0, failures
    only = os.environ.get("SLUMPY_CASES_FOR")  # a mutant in this script: only cases that run it
    if only:
        cases = [c for c in cases if c[1].get("script", ["check"])[0] in (only, "check")
                 or any(step.get("script", c[1]["script"])[0] in (only, "check")
                        for step in c[1].get("runs", []))]
    fail_fast = bool(os.environ.get("SLUMPY_FAIL_FAST"))
    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        template = make_template(tmp)
        def one_case(item):
            n, (desc, c) = item
            try:
                return None if run_case(template, tmp, n, c) else desc
            except Exception as e:  # a broken case or a timeout is a failure, never a pass
                return f"{desc} (case error: {e})"
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
            futures = [pool.submit(one_case, item) for item in enumerate(cases)]
            failures = []
            for fut in concurrent.futures.as_completed(futures):
                if fut.result():
                    failures.append(fut.result())
                    if fail_fast:
                        for other in futures:
                            other.cancel()
                        break
    return len(cases), failures


# Generated mutants: every condition forced true and false, each operand of and/or dropped, each
# `not` removed, each single comparison flipped, each integer moved by one (an exit code or return
# value only between zero and non-zero), each statement removed.
# A survivor is logic no case observes, unless EQUIVALENT lists it with the reason it cannot change
# behavior; an EQUIVALENT entry that matches no generated mutant is stale and fails the run.
GENERATED_FROM = ["check", "check-risk", "check-lessons", "check-layers", "check-pointers",
                  "check-upkeep"]
FLIP = {ast.Gt: ">=", ast.GtE: ">", ast.Lt: "<=", ast.LtE: "<", ast.Eq: "!=", ast.NotEq: "==",
        ast.In: "not in", ast.NotIn: "in", ast.Is: "is not", ast.IsNot: "is"}
# (script, mutation, the original line stripped): why the mutant cannot change what the check reports.
CRASH = "the hook's crash handler: no input the cases can build crashes the hook"
NONE_EXIT = "returning None exits with 0 as well"
EQUIVALENT = {
    ("check", "condition always true at column 3", 'if __name__ == "__main__":'): "the file only runs as a script",
    ("check", "statement removed at column 0", "return 0"): NONE_EXIT,
    ("check", "statement removed at column 0, occurrence 2", "return 0"): NONE_EXIT,
    ("check", "statement removed at column 0, occurrence 3", "return 0"): NONE_EXIT,
    ("check", "exit code 0 to 1 at column 7, occurrence 3", "return 0"): CRASH,
    ("check", "condition always false at column 5", "elif error:"): CRASH,
    ("check", "statement removed at column 0", 'out = {"decision": "block", "reason": reason}'): CRASH,
    ("check", "statement removed at column 0", 'respond("scripts/check --hook crashed:\\n" + traceback.format_exc(), continuing, error=True)'): CRASH,
    ("check", "condition always true at column 31", 'last = out.splitlines()[-1] if out else ""'): "every check prints at least one line",
    ("check", "1 to 0 at column 25", 'last = out.splitlines()[-1] if out else ""'): "the summary shows one line of a check's output and the full output follows; which line is cosmetic",
    ("check", "0 to 1 at column 14", 'failed.insert(0, "change set: " + (changed.stdout + changed.stderr).strip())'): "the order of the reasons in the message is cosmetic",
    ("check", "operand 2 of or dropped at column 29", 'continuing = bool(json.loads(sys.stdin.read() or "{}").get("stop_hook_active"))'): "an empty stdin fails to parse and leaves continuing False, as {} does",
    ("check-risk", "condition always true at column 3", 'if __name__ == "__main__":'): "the file only runs as a script",
    ("check-risk", "statement removed at column 0", "return 0"): NONE_EXIT,
    ("check-risk", "condition always true at column 51", 'return [n for n in out(*args, "-z").split("\\0") if n]'): "an empty name matches no rule and is no file, and the hook strips NUL separators",
    ("check-risk", "condition always true at column 59", "added = {f: added_lines(b, f, untracked) for f in files if (ROOT / f).is_file()}"): "the diff of a deleted file adds no lines",
    ("check-layers", "statement removed at column 0", 'line = ""'): "a fence line holds no term and no Cyrillic",
    ("check-layers", "statement removed at column 0, occurrence 2", 'line = ""'): "a fence line holds no term and no Cyrillic",
    ("check-layers", "operand 1 of and dropped at column 5", 'elif in_fm and line == "---":'): "outside the frontmatter in_fm is already False, and the line holds no term",
    ("check-layers", "operand 1 of and dropped at column 5", 'elif in_fm and line.startswith("paths:"):'): "outside the frontmatter only the 'paths:' line itself is blanked; its list items still need in_fm",
    ("check-layers", "operand 1 of and dropped at column 5", r'elif in_fm and in_paths and re.match(r"\s+- ", line):'): "after the closing fence the first body line, never an indented list item, resets in_paths",
    ("check-layers", "condition always true at column 49", 'text = " ".join(l for l in lines(PROCESS)[1:] if l.strip())'): "blank lines add only spaces to the joined paragraph",
    ("check-layers", "1 to 2 at column 42", 'text = " ".join(l for l in lines(PROCESS)[1:] if l.strip())'): "line 1 is the blank line after the title",
    ("check-layers", "1 to 0 at column 42", 'text = " ".join(l for l in lines(PROCESS)[1:] if l.strip())'): "the title holds no backticked file name",
    ("check-layers", "1 to 2 at column 39", 'sentence = text.split(" are the core", 1)[0]'): "a higher maxsplit keeps the same first part",
    ("check-pointers", "operand 1 of and dropped at column 3", "if f and not f.startswith(FROZEN) and (ROOT / f).is_file()]"): "an empty name is no file, so the last operand drops it too",
    ("check-pointers", "statement removed at column 0, occurrence 2", "continue"): "with no candidates the next test skips the pointer as well",
    ("check-pointers", "1 to 2 at column 9", "status = 1"): "status is only compared with 0 and passed to sys.exit",
    ("check-pointers", "1 to 2 at column 9, occurrence 2", "status = 1"): "status is only compared with 0 and passed to sys.exit",
    ("check-upkeep", "1 to 2 at column 36", 'lines = text.split("\\n## Upkeep\\n", 1)[1].split("\\n## ", 1)[0].splitlines()'): "the section still ends at the next heading",
    ("check-upkeep", "1 to 2 at column 57", 'lines = text.split("\\n## Upkeep\\n", 1)[1].split("\\n## ", 1)[0].splitlines()'): "a higher maxsplit keeps the same first part",
    ("check-upkeep", "14 to 15 at column 74", "latest = datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=14))).date()"): "an hour's shift moves the latest date during one hour a day only",
    ("check-upkeep", "14 to 13 at column 74", "latest = datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=14))).date()"): "an hour's shift moves the latest date during one hour a day only",
}


def generated_mutants(root=ROOT):
    out = []
    for script in GENERATED_FROM:
        src = (root / "scripts" / script).read_text(encoding="utf-8")
        lines = src.splitlines(keepends=True)
        starts = [0]
        for l in lines:
            starts.append(starts[-1] + len(l))
        def pos(line, col):  # ast columns count UTF-8 bytes
            return starts[line - 1] + len(lines[line - 1].encode()[:col].decode())
        tree = ast.parse(src)
        in_fstring = {id(n) for j in ast.walk(tree) if isinstance(j, ast.JoinedStr)
                      for n in ast.walk(j)}
        def seg(n):
            return src[pos(n.lineno, n.col_offset):pos(n.end_lineno, n.end_col_offset)]
        def add(n, new, what):
            a, b = pos(n.lineno, n.col_offset), pos(n.end_lineno, n.end_col_offset)
            column = a - starts[n.lineno - 1] - (len(lines[n.lineno - 1]) - len(lines[n.lineno - 1].lstrip()))
            out.append((script, a, b, new, f"{what} at column {column}", lines[n.lineno - 1].strip()))
        exit_codes = {id(n.value) for n in ast.walk(tree) if isinstance(n, ast.Return) and n.value} | {
            id(n.args[0]) for n in ast.walk(tree) if isinstance(n, ast.Call) and n.args
            and ast.unparse(n.func) == "sys.exit"}
        for n in ast.walk(tree):
            if id(n) in in_fstring:
                continue
            tests = [n.test] if isinstance(n, (ast.If, ast.While, ast.IfExp)) else []
            tests += n.ifs if isinstance(n, ast.comprehension) else []
            for t in tests:
                add(t, "True", "condition always true")
                add(t, "False", "condition always false")
            if isinstance(n, ast.BoolOp):
                op = " and " if isinstance(n.op, ast.And) else " or "
                for i in range(len(n.values)):
                    rest = [seg(v) for j, v in enumerate(n.values) if j != i]
                    add(n, "(" + op.join(rest) + ")", f"operand {i + 1} of {op.strip()} dropped")
            if isinstance(n, ast.UnaryOp) and isinstance(n.op, ast.Not):
                add(n, "(" + seg(n.operand) + ")", "not removed")
            if isinstance(n, ast.Compare) and len(n.ops) == 1 and type(n.ops[0]) in FLIP:
                new_op = FLIP[type(n.ops[0])]
                add(n, f"({seg(n.left)} {new_op} {seg(n.comparators[0])})", f"comparison to {new_op}")
            if isinstance(n, ast.Constant) and type(n.value) is int and id(n) in exit_codes:
                add(n, "1" if n.value == 0 else "0", f"exit code {n.value} to {1 if n.value == 0 else 0}")
            elif isinstance(n, ast.Constant) and type(n.value) is int:
                add(n, str(n.value + 1), f"{n.value} to {n.value + 1}")
                if n.value > 0:
                    add(n, str(n.value - 1), f"{n.value} to {n.value - 1}")
            if isinstance(n, (ast.Assign, ast.AugAssign, ast.Return, ast.Continue, ast.Break,
                              ast.Raise)) or (isinstance(n, ast.Expr)
                                              and not isinstance(n.value, ast.Constant)):
                add(n, "pass", "statement removed")
    seen = {}                                     # the same mutation on identical lines: number them
    for i, (script, a, b, new, what, line) in enumerate(out):
        k = seen[script, what, line] = seen.get((script, what, line), 0) + 1
        if k > 1:
            out[i] = (script, a, b, new, f"{what}, occurrence {k}", line)
    return out


def run_copy(mutant=None):
    with tempfile.TemporaryDirectory() as tmp:
        d = pathlib.Path(tmp) / "copy"
        copy_files(ROOT, d)
        env = dict(ENV)
        if mutant and len(mutant) == 4:            # hand-written: (script, old, new, label)
            script, old, new, label = mutant
            f = d / "scripts" / script
            s = f.read_text(encoding="utf-8")
            if s.count(old) != 1:
                return f"stale mutant (text found {s.count(old)} times): {label}"
            f.write_text(s.replace(old, new), encoding="utf-8")
            name = f"{label} ({script})"
        elif mutant:                               # generated: (script, start, end, new, what, line)
            script, a, b, new, what, line = mutant
            f = d / "scripts" / script
            s = f.read_text(encoding="utf-8")
            f.write_text(s[:a] + new + s[b:], encoding="utf-8")
            name = f"{script}: {what}: {line}"
        if mutant:
            env.update(SLUMPY_CASES_FOR=script, SLUMPY_FAIL_FAST="1")
        try:
            p = subprocess.run([sys.executable, "-I", str(d / "scripts" / "test-checks")], cwd=d,
                               capture_output=True, text=True, env=env, timeout=600)
            failed = p.returncode != 0
        except subprocess.TimeoutExpired:
            failed = True
        if mutant is None:
            return None if not failed else "baseline fails; mutants not measured:\n" + p.stdout
        return None if failed else f"surviving mutant: {name}"


def main():
    if "--mutants" in sys.argv:
        baseline = run_copy()
        if baseline:
            print(baseline)
            return 1
        generated = generated_mutants()
        keys = {(m[0], m[4], m[5]) for m in generated}
        stale = [f"stale EQUIVALENT entry: {k}" for k in EQUIVALENT if k not in keys]
        todo = MUTANTS + [m for m in generated if (m[0], m[4], m[5]) not in EQUIVALENT]
        with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
            problems = stale + [r for r in pool.map(run_copy, todo) if r]
        total = len(MUTANTS) + len(generated)
        if problems:
            print("\n".join(problems))
            print(f"test-checks: {len(problems)} of {total} mutants survive or are stale")
            return 1
        print(f"test-checks: all {len(todo)} mutants killed ({len(MUTANTS)} written, "
              f"{len(generated)} generated, {len(generated) + len(MUTANTS) - len(todo)} equivalent)")
        return 0
    total, failures = run_cases()
    if failures:
        print("\n".join(failures))
        print(f"test-checks: {len(failures)} of {total or '?'} cases failed")
        return 1
    print(f"test-checks: {total} cases pass")
    return 0


sys.exit(main())
