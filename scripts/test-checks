def rule_lines():
    lines = (ROOT / "scripts/risk-paths").read_text(encoding="utf-8").splitlines()
    return sum(1 for l in lines if l.strip() and not l.lstrip().startswith("#"))


def all_cases():
    p = subprocess.run([sys.executable, "-I", str(ROOT / "scripts/check-risk"), "--rules"],
                       cwd=ROOT, capture_output=True, text=True)
    if p.returncode != 0:
        return None, [f"check-risk --rules failed: {(p.stdout + p.stderr).strip()}"]
    rules = json.loads(p.stdout)
    if len(rules) != rule_lines():
        return None, [f"check-risk --rules returned {len(rules)} rules for {rule_lines()} rule lines"]
    return STATIC + rule_cases(rules) + check_cases(), []


def run_cases():
    cases, failures = all_cases()
    if cases is None:
        return 0, failures
    only = os.environ.get("SLUMPY_CASES_FOR")  # a mutant in this script: only cases that run it
    if not only:
        try:
            test_process_cleanup()
        except Exception as error:
            return 0, [f"process-tree cleanup regression failed: {error}"]
    if only:
        cases = [c for c in cases if c[1].get("script", ["check"])[0] in (only, "check")
                 or any(step.get("script", c[1]["script"])[0] in (only, "check")
                        for step in c[1].get("runs", []))]
    fail_fast = bool(os.environ.get("SLUMPY_FAIL_FAST"))
    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        template = make_template(tmp)
        def one_case(item):
            n, (desc, c) = item
            try:
                return None if run_case(template, tmp, n, c) else desc
            except Exception as e:  # a broken case or a timeout is a failure, never a pass
                return f"{desc} (case error: {e})"
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
            futures = [pool.submit(one_case, item) for item in enumerate(cases)]
            failures = []
            for fut in concurrent.futures.as_completed(futures):
                if fut.result():
                    failures.append(fut.result())
                    if fail_fast:
                        for other in futures:
                            other.cancel()
                        break
    return len(cases) + (not only), failures


def test_process_cleanup():
    """A timed-out parent must not leave its child writing into a disposed fixture."""
    with tempfile.TemporaryDirectory() as folder:
        root = pathlib.Path(folder)
        child = root / "child.py"
        child.write_text("import pathlib, time\npathlib.Path('ready').touch()\n"
                         "time.sleep(7)\npathlib.Path('late').touch()\n", encoding="utf-8")
        parent = root / "parent.py"
        parent.write_text("import subprocess, sys, time\n"
                          "subprocess.Popen([sys.executable, 'child.py'], start_new_session=True)\n"
                          "time.sleep(60)\n", encoding="utf-8")
        try:
            run_bounded([sys.executable, str(parent)], cwd=root, timeout=5)
        except subprocess.TimeoutExpired:
            assert (root / "ready").exists(), "child never started; cleanup was not exercised"
            time.sleep(7)
            assert not (root / "late").exists(), "child survived its parent's timeout"
        else:
            raise AssertionError("parent did not time out")


# Generated mutants: every condition forced true and false, each operand of and/or dropped, each
# operand of a binary operator dropped, each `not` removed, each operator of a comparison flipped,
# each integer moved by one (an exit code or return value only between zero and non-zero), each
# statement removed, startswith/endswith turned into `in` and `==`, fullmatch/match/search swapped,
# each strip/lower-style string method dropped, each string argument and each keyword argument of
# a call dropped (except `encoding`: the self-test runs under a UTF-8 locale and cannot observe it).
# A survivor is logic no case observes. EQUIVALENT lists only mutants that cannot change what a
# check reports on any input, each with its reason; code no case could reach is made reachable by a
# test seam (SLUMPY_TEST_HOOK_CRASH, SLUMPY_NOW) instead of being listed.
# An entry is keyed by script, enclosing function, mutation, and line, and must match exactly one
# generated mutant; one that matches none or several fails the run.
GENERATED_FROM = ["check", "check-risk", "check-lessons", "check-layers", "check-pointers",
                  "check-upkeep"]
OPS = {ast.Gt: ">", ast.GtE: ">=", ast.Lt: "<", ast.LtE: "<=", ast.Eq: "==", ast.NotEq: "!=",
       ast.In: "in", ast.NotIn: "not in", ast.Is: "is", ast.IsNot: "is not"}
FLIP = {ast.Gt: ">=", ast.GtE: ">", ast.Lt: "<=", ast.LtE: "<", ast.Eq: "!=", ast.NotEq: "==",
        ast.In: "not in", ast.NotIn: "in", ast.Is: "is not", ast.IsNot: "is"}
MATCHERS = ("fullmatch", "match", "search")
STRING_METHODS = ("strip", "lstrip", "rstrip", "lower", "upper", "casefold")
NONE_EXIT = "the function's value becomes the exit code, and None exits with 0 as 0 does"
EQUIVALENT = {
    ("check", "run_hook", "argument 4 dropped at column 0", 'respond("scripts/check --hook crashed:\\n" + traceback.format_exc(), continuing, error=True, codex=codex)'): "error=True already selects the block response for either client; continuing selects systemMessage before testing either flag, so codex cannot change any CLI result in this call",
    # script() has only two callers: run_checks and hook. They consume returncode only as
    # == 0 / != 0; no exact internal code is printed or returned by the CLI. These four
    # changes preserve every caller outcome. Written zero-code mutants test the real boundary.
    ("check", "script", "124 to 125 at column 44", 'return subprocess.CompletedProcess(command, 124, "", "unavailable: check timed out")'): "internal nonzero code; all callers distinguish zero from nonzero only",
    ("check", "script", "124 to 123 at column 44", 'return subprocess.CompletedProcess(command, 124, "", "unavailable: check timed out")'): "internal nonzero code; all callers distinguish zero from nonzero only",
    ("check", "script", "127 to 128 at column 44", 'return subprocess.CompletedProcess(command, 127, "", "unavailable: " + str(error))'): "internal nonzero code; all callers distinguish zero from nonzero only",
    ("check", "script", "127 to 126 at column 44", 'return subprocess.CompletedProcess(command, 127, "", "unavailable: " + str(error))'): "internal nonzero code; all callers distinguish zero from nonzero only",
    ("check", "<module>", "condition always true at column 3", 'if __name__ == "__main__":'): "the file only runs as a script",
    ("check-risk", "<module>", "condition always true at column 3", 'if __name__ == "__main__":'): "the file only runs as a script",
    ("check", "hook", "statement removed at column 0", "return 0"): NONE_EXIT,
    ("check", "main", "statement removed at column 0", "return 0"): NONE_EXIT,
    ("check-risk", "main", "statement removed at column 0", "return 0"): NONE_EXIT,
    ("check-risk", "check", "statement removed at column 0", "return 0"): NONE_EXIT,
    ("check", "run_hook", "statement removed at column 0", "return 0"): NONE_EXIT,
    ("check-layers", "lines", "operand 1 of and dropped at column 5", 'elif in_fm and line == "---":'): "outside the frontmatter in_fm is already False, and only frontmatter lines are ever blanked",
    ("check-upkeep", "<module>", "startswith to in at column 48", 'start = next((i for i, l in enumerate(lines) if l.strip().startswith("|")), len(lines))'): "a line with | before the first row is reported with the same message either way: as a stray line, or as a block line without a leading |",
}


def generated_mutants(root=ROOT):
    """(script, start, end, replacement, mutation, line, enclosing function) for every mutant."""
    out = []
    for script in GENERATED_FROM:
        src = (root / "scripts" / script).read_text(encoding="utf-8")
        lines = src.splitlines(keepends=True)
        starts = [0]
        for l in lines:
            starts.append(starts[-1] + len(l))
        def pos(line, col):  # ast columns count UTF-8 bytes
            return starts[line - 1] + len(lines[line - 1].encode()[:col].decode())
        tree = ast.parse(src)
        in_fstring = {id(n) for j in ast.walk(tree) if isinstance(j, ast.JoinedStr)
                      for n in ast.walk(j)}
        owner = {}                                # innermost enclosing function of each node
        for fn in ast.walk(tree):
            if isinstance(fn, ast.FunctionDef):
                for n in ast.walk(fn):
                    owner[id(n)] = fn.name
        def seg(n):
            return src[pos(n.lineno, n.col_offset):pos(n.end_lineno, n.end_col_offset)]
        def seg_from(n, col, end_line, end_col):  # from a column on the call's first line to its end
            return src[pos(n.func.end_lineno, col):pos(end_line, end_col)]
        def add(n, new, what):
            a, b = pos(n.lineno, n.col_offset), pos(n.end_lineno, n.end_col_offset)
            text = lines[n.lineno - 1]
            column = a - starts[n.lineno - 1] - (len(text) - len(text.lstrip()))
            out.append((script, a, b, new, f"{what} at column {column}", text.strip(),
                        owner.get(id(n), "<module>")))
        exit_codes = {id(n.value) for n in ast.walk(tree) if isinstance(n, ast.Return) and n.value} | {
            id(n.args[0]) for n in ast.walk(tree) if isinstance(n, ast.Call) and n.args
            and ast.unparse(n.func) == "sys.exit"}
        for n in ast.walk(tree):
            if id(n) in in_fstring:
                continue
            tests = [n.test] if isinstance(n, (ast.If, ast.While, ast.IfExp)) else []
            tests += n.ifs if isinstance(n, ast.comprehension) else []
            for t in tests:
                add(t, "True", "condition always true")
                add(t, "False", "condition always false")
            if isinstance(n, ast.BoolOp):
                op = " and " if isinstance(n.op, ast.And) else " or "
                for i in range(len(n.values)):
                    rest = [seg(v) for j, v in enumerate(n.values) if j != i]
                    add(n, "(" + op.join(rest) + ")", f"operand {i + 1} of {op.strip()} dropped")
            if isinstance(n, ast.BinOp):
                add(n, "(" + seg(n.left) + ")", "right operand dropped")
                add(n, "(" + seg(n.right) + ")", "left operand dropped")
            if isinstance(n, ast.UnaryOp) and isinstance(n.op, ast.Not):
                add(n, "(" + seg(n.operand) + ")", "not removed")
            if isinstance(n, ast.Compare) and all(type(o) in OPS for o in n.ops):
                for i, o in enumerate(n.ops):
                    parts = [seg(n.left)]
                    for j, (op_j, right) in enumerate(zip(n.ops, n.comparators)):
                        parts += [FLIP[type(op_j)] if j == i else OPS[type(op_j)], seg(right)]
                    add(n, "(" + " ".join(parts) + ")", f"comparison {i + 1} to {FLIP[type(o)]}")
            if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute):
                obj, attr = seg(n.func.value), n.func.attr
                if attr in ("startswith", "endswith") and len(n.args) == 1 and not n.keywords:
                    add(n, f"({seg(n.args[0])} in {obj})", f"{attr} to in")
                    add(n, f"({obj} == {seg(n.args[0])})", f"{attr} to ==")
                if attr in MATCHERS:
                    rest = n.func.end_col_offset, n.end_lineno, n.end_col_offset
                    for other in MATCHERS:
                        if other != attr:
                            add(n, f"{obj}.{other}{seg_from(n, *rest)}", f"{attr} to {other}")
                if attr in STRING_METHODS:
                    add(n, f"({obj})", f".{attr}() dropped")
            if isinstance(n, ast.Call):
                parts = [(a, isinstance(a, ast.Constant) and type(a.value) is str) for a in n.args]
                parts += [(k, k.arg != "encoding") for k in n.keywords]
                for i, (dropped, mutable) in enumerate(parts):
                    if mutable:
                        kept = [seg(x) for j, (x, _) in enumerate(parts) if j != i]
                        add(n, f"{seg(n.func)}({', '.join(kept)})", f"argument {i + 1} dropped")
            if isinstance(n, ast.Constant) and type(n.value) is int and id(n) in exit_codes:
                add(n, "1" if n.value == 0 else "0", f"exit code {n.value} to {1 if n.value == 0 else 0}")
            elif isinstance(n, ast.Constant) and type(n.value) is int:
                add(n, str(n.value + 1), f"{n.value} to {n.value + 1}")
                if n.value > 0:
                    add(n, str(n.value - 1), f"{n.value} to {n.value - 1}")
            if isinstance(n, (ast.Assign, ast.AugAssign, ast.Return, ast.Continue, ast.Break,
                              ast.Raise)) or (isinstance(n, ast.Expr)
                                              and not isinstance(n.value, ast.Constant)):
                add(n, "pass", "statement removed")
    return out


def key(m):
    script, _, _, _, what, line, function = m
    return script, function, what, line


def run_copy(mutant=None, now=None):
    with tempfile.TemporaryDirectory() as tmp:
        d = pathlib.Path(tmp) / "copy"
        copy_files(ROOT, d)
        env = dict(ENV, SLUMPY_NOW=now) if now else dict(ENV)
        if mutant and len(mutant) == 4:            # written: (script, old, new, label)
            script, old, new, label = mutant
            f = d / "scripts" / script
            s = f.read_text(encoding="utf-8")
            if s.count(old) != 1:
                return f"stale mutant (text found {s.count(old)} times): {label}"
            f.write_text(s.replace(old, new), encoding="utf-8")
            name = f"{label} ({script})"
        elif mutant:                               # generated, see generated_mutants
            script, a, b, new, what, line, function = mutant
            f = d / "scripts" / script
            s = f.read_text(encoding="utf-8")
            f.write_text(s[:a] + new + s[b:], encoding="utf-8")
            name = f"{script}, {function}: {what}: {line}"
        if mutant:
            env.update(SLUMPY_CASES_FOR=script, SLUMPY_FAIL_FAST="1")
        try:
            p = run_bounded([sys.executable, "-I", str(d / "scripts" / "test-checks")], cwd=d,
                               text=True, env=env, timeout=600)
        except subprocess.TimeoutExpired:            # neither a kill nor a pass: report it
            return f"self-test timed out: {name if mutant else 'baseline'}"
        if mutant is None:
            return None if p.returncode == 0 else "baseline fails; mutants not measured:\n" + p.stdout
        return None if p.returncode != 0 else f"surviving mutant: {name}"


def main():
    if "--mutants" in sys.argv:
        # One instant for the whole run, so a date that falls due mid-run cannot fail the cases.
        now = os.environ.get("SLUMPY_NOW") or datetime.datetime.now(datetime.timezone.utc).isoformat()
        baseline = run_copy(now=now)
        if baseline:
            print(baseline)
            return 1
        generated = generated_mutants()
        count = {}
        for m in generated:
            count[key(m)] = count.get(key(m), 0) + 1
        stale = [f"EQUIVALENT entry matches {count.get(k, 0)} mutants, not one: {k}"
                 for k in EQUIVALENT if count.get(k, 0) != 1]
        todo = MUTANTS + [m for m in generated if key(m) not in EQUIVALENT]
        with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
            problems = stale + [r for r in pool.map(lambda m: run_copy(m, now), todo) if r]
        total = len(MUTANTS) + len(generated)
        if problems:
            print("\n".join(problems))
            print(f"test-checks: {len(problems)} of {total} mutants survive or are stale")
            return 1
        print(f"test-checks: all {len(todo)} mutants killed ({len(MUTANTS)} written, "
              f"{len(generated)} generated, {len(generated) + len(MUTANTS) - len(todo)} equivalent)")
        return 0
    total, failures = run_cases()
    if failures:
        print("\n".join(failures))
        print(f"test-checks: {len(failures)} of {total or '?'} cases failed")
        return 1
    print(f"test-checks: {total} cases pass")
    return 0


sys.exit(main())
