def upkeep_doc(body): return (UPKEEP, "# Agent system\n\n## Upkeep\n\n" + body + "\n## Mechanism ledger\n\n| # | x |\n|---|---|\n| 1 | y |\n", "write")
T1_LINE = "- T1 because the test needs it.\n"
SEC_LINE = "- Security pass: clean, reviewer code round 1.\n"
PLAN = "work/feature/plan.md"

# The line each check prints when it passes, and only then.
SUCCESS = {"check-layers": "core files clean", "check-pointers": "all section pointers resolve",
           "check-risk": "evidence present where needed", "check-lessons": "none overdue",
           "check-upkeep": "none due"}
def lines_of(path): return len((ROOT / path).read_text(encoding="utf-8").splitlines())
# A failure each check must report, for the data-driven cases over CHECKS, and the detail it prints.
PLANT_TEXT = {"check-layers": f"core-process.md:{lines_of('.claude/rules/core-process.md') + 2}: platform or project term: Slumpy uses iOS 18.",
              "check-pointers": "has no section 'Risk tiers'",
              "check-risk": "security-pass trigger without an added 'Security pass:' line in a work/*/plan.md (scripts/risk-paths): App/Store.swift",
              "check-lessons": "lesson 'Old trap'", "check-upkeep": "upkeep 'Invalid task': the interval"}
PLANT = {"check-layers": [CORE_BAD], "check-pointers": [POINTER_BAD], "check-risk": [KEYCHAIN],
         "check-lessons": [OVERDUE], "check-upkeep": [UPKEEP_BAD]}


def one(edits=(), commit=False, git=(), stdin=None, git_before=(), cwd="."):
    return [dict(edits=list(edits), commit=commit, git=list(git), stdin=stdin, git_before=list(git_before), cwd=cwd)]


def notes(text): return [("work/feature/notes.md", text, "write")]


def example_path(glob):
    return glob.replace("**/", "x/").replace("**", "a").replace("*", "a")


def rule_cases(rules):
    cases = []
    for r in rules:
        cat, n = r["category"], r["line"]
        kind = cat.removesuffix("-text")
        if cat.endswith("-text"):
            files = [(f"App/Rule{n}.swift", r["example"] + "\n", "write")]
        else:
            files = [(example_path(r["pattern"]), "x\n", "write")]
            if r["pattern"].startswith("**/"):
                files_root = [(example_path(r["pattern"][3:]), "x\n", "write")]
            else:
                files_root = None
        other = SEC_LINE if kind == "t2" else T1_LINE      # evidence for the other kind only
        own = T1_LINE if kind == "t2" else SEC_LINE
        variants = [("", files)]
        if not cat.endswith("-text") and files_root:
            variants.append((" at the root", files_root))
        for label, fs in variants:
            cases.append((f"risk-paths:{n} {cat} {r['pattern']}{label} without its evidence fails",
                          dict(runs=one(fs + [(PLAN, other, "write")]), script=["check-risk"], expect=fails)))
            cases.append((f"risk-paths:{n} {cat} {r['pattern']}{label} with its evidence passes",
                          dict(runs=one(fs + [(PLAN, other + own, "write")]), script=["check-risk"], expect=passes)))
    return cases


def check_cases():
    src = (ROOT / "scripts/check").read_text(encoding="utf-8")
    checks = next(ast.literal_eval(node.value) for node in ast.walk(ast.parse(src))
                  if isinstance(node, ast.Assign) and getattr(node.targets[0], "id", "") == "CHECKS")
    cases = [("every check in scripts/check has a planted failure, its detail, and its success line here",
              dict(script=["check-lessons"], expect=lambda o, c=checks: set(c) == set(PLANT)
                   == set(PLANT_TEXT) == set(SUCCESS) and all(PLANT[k] for k in c))),
             ("scripts/check passes a clean copy and says what it did not run",
              dict(script=["check"], expect=lambda o, c=checks: passes(o)
                   and all(f"[ok] {k}: " in o[-1].stdout and SUCCESS[k] in o[-1].stdout for k in c)
                   and "[not run] build, tests, lint" in o[-1].stdout
                   and "[not run] test-checks" in o[-1].stdout
                   and not any(f"[ok] {k}: {k}:" in o[-1].stdout for k in c)))]
    for name in checks:
        plant = PLANT.get(name)
        if not plant:
            continue
        cases.append((f"{name} reports its planted failure and not its success line",
                      dict(runs=one(plant), script=[name], expect=lambda o, n=name: fails_with(PLANT_TEXT[n])(o) and SUCCESS[n] not in o[-1].stdout)))
        cases.append((f"scripts/check reports a failure of {name}",
                      dict(runs=one(plant), script=["check"], expect=lambda o, n=name: fails(o) and f"[FAIL] {n}" in o[-1].stdout and f"\n\n{n}:\n" in o[-1].stdout and PLANT_TEXT[n] in o[-1].stdout)))
        cases.append((f"the hook blocks on a failure of {name}",
                      dict(runs=one(plant, stdin=HOOK), script=["check", "--hook"], expect=lambda o, n=name: is_block(o[-1])
                           and context(o[-1]).startswith("scripts/check failed; fix before finishing:\n[")
                           and all(t in context(o[-1]) for t in (f"[FAIL] {n}: ", f"[not run] test-checks: on demand\n\n{n}:\n", PLANT_TEXT[n])))))
    return cases


