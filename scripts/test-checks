#!/usr/bin/env python3
"""Self-test of the checks, on throwaway git copies of the agent-system files; never touches the
repository.

Cases: each planted violation fails its check, each valid change passes, an input a check cannot
read fails it, and every skip path has a case whose skipped input holds a violation. Cases are
also built from data: one per rule in scripts/risk-paths (`check-risk --rules`, whose count is
checked against the rule lines counted here) and one per entry of CHECKS in scripts/check, each
with a planted failure, so a rule or check without a working case fails the self-test. Add a case
with every new skip path or input.

--mutants: runs the unmodified self-test first (a failing baseline fails the run), then applies
each written mutant in MUTANTS and each mutant generated from the code of the checks
(GENERATED_FROM) to a copy of the scripts; the self-test, limited to the cases that run the
mutated script, must fail on each. A surviving mutant is logic no case observes, unless EQUIVALENT
gives the reason it cannot change what the check reports. A written mutant whose text no longer
occurs exactly once, or an EQUIVALENT entry that matches no generated mutant, is stale and fails
the run. Run it after every change to scripts/ (on demand: about 20 minutes).
"""
import ast, concurrent.futures, datetime, json, os, pathlib, re, shutil, signal, subprocess, sys, tempfile, time

ROOT = pathlib.Path(__file__).resolve().parent.parent
COPY = ["AGENTS.md", "CLAUDE.md", "README.md", "backlog.md", ".claude", ".agents", "docs", "work", "scripts"]
GIT = ["git", "-c", "user.name=test", "-c", "user.email=test@example.invalid",
       "-c", "commit.gpgsign=false"]
ENV = dict(os.environ)
ENV.pop("SLUMPY_CHECK_BASE", None)  # each fixture owns its history and comparison base
# The cases' clock: SLUMPY_NOW when --mutants fixes one instant for the whole run, else the time
# now. A case with its own SLUMPY_NOW overrides it; SLUMPY_NOW="" makes a check read the real clock.
NOW = (datetime.datetime.fromisoformat(os.environ["SLUMPY_NOW"]) if os.environ.get("SLUMPY_NOW")
       else datetime.datetime.now(datetime.timezone.utc))
TODAY = NOW.astimezone(datetime.timezone.utc).date().isoformat()
# Fixed instants for the date cases (SLUMPY_NOW). On 2030-06-15 at these hours, today in UTC+14 and
# in UTC-12 differ from today in UTC+15, UTC+13, UTC-11, and UTC-13, so a shifted zone changes a
# result: 09:30 UTC is 06-15 in UTC+14 and 06-16 in UTC+15; 10:30 is 06-16 in UTC+14 and 06-15 in
# UTC+13; 11:30 is 06-14 in UTC-12 and 06-15 in UTC-11; 12:30 is 06-15 in UTC-12 and 06-14 in UTC-13.
def AT(hour): return {"SLUMPY_NOW": f"2030-06-15T{hour}:30:00+00:00"}
LESSON = ("\n### {title}\n\n- **Symptom:** x\n- **Cause:** y\n- **Now guarded by:** {guard}\n"
          "- **Stale when:** z\n- **Added:** {added}\n")


def sh(d, *cmd):
    run_bounded(GIT + list(cmd), cwd=d, timeout=60).check_returncode()


def kill_posix_tree(pid):
    """Freeze owned fixture descendants before killing, including nested process sessions.

    Fixtures wait for their children; daemonizing/detaching fixtures are not supported.
    """
    stopped = set()
    pending = {pid}
    try:
        for _ in range(16):
            for child in pending:
                try:
                    os.kill(child, signal.SIGSTOP)
                    stopped.add(child)
                except ProcessLookupError:
                    pass
            listing = subprocess.run(["ps", "-e", "-o", "pid=", "-o", "ppid="],
                                     capture_output=True, text=True, check=True, timeout=15)
            parents = [tuple(map(int, line.split())) for line in listing.stdout.splitlines()]
            pending = {child for child, parent in parents if parent in stopped} - stopped
            if not pending:
                break
        else:
            raise RuntimeError("fixture process tree exceeds cleanup depth budget")
    finally:
        for child in stopped:
            try:
                os.kill(child, signal.SIGKILL)
            except ProcessLookupError:
                pass


def run_bounded(command, *, timeout, input=None, **kwargs):
    """Kill the owned process tree on timeout, including a check spawned by scripts/check."""
    with subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, start_new_session=os.name != "nt",
                          **kwargs) as process:
        try:
            stdout, stderr = process.communicate(input, timeout=timeout)
        except subprocess.TimeoutExpired:
            try:
                if os.name == "nt":
                    subprocess.run(["taskkill", "/PID", str(process.pid), "/T", "/F"],
                                   capture_output=True, check=True, timeout=15)
                else:
                    kill_posix_tree(process.pid)
            finally:
                process.kill()
                process.wait(timeout=15)
            raise
        return subprocess.CompletedProcess(command, process.returncode, stdout, stderr)


def copy_files(src_root, dst):
    dst.mkdir(parents=True)
    for name in COPY:
        src = src_root / name
        if src.is_dir():
            shutil.copytree(src, dst / name, ignore=shutil.ignore_patterns("__pycache__"))
        elif src.exists():
            shutil.copy2(src, dst / name)


def make_template(tmp):
    t = tmp / "template"
    copy_files(ROOT, t)
    sh(t, "init", "-q", "-b", "dev")
    sh(t, "add", "-A")
    sh(t, "commit", "-q", "-m", "base")
    sh(t, "checkout", "-q", "-b", "work")
    return t


def apply(d, edits):
    for path, text, mode in edits:
        f = d / path
        if mode == "bytes":
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_bytes(text)
            continue
        if mode == "delete":
            shutil.rmtree(f) if f.is_dir() else f.unlink()
            continue
        f.parent.mkdir(parents=True, exist_ok=True)
        if mode == "append":
            f.write_text(f.read_text(encoding="utf-8") + text, encoding="utf-8")
        elif mode == "prepend-entry":  # insert as the first lesson entry
            s = f.read_text(encoding="utf-8")
            f.write_text(s.replace("## Entries\n", "## Entries\n" + text, 1), encoding="utf-8")
        elif mode == "replace":
            old, new = text
            s = f.read_text(encoding="utf-8")
            assert old in s, f"'{old}' not in {path}"
            f.write_text(s.replace(old, new, 1), encoding="utf-8")
        else:
            f.write_text(text, encoding="utf-8")


def run_case(template, tmp, n, c):
    d = tmp / f"case{n}"
    shutil.copytree(template, d)
    if c.get("base"):                       # committed on dev before the work branch
        sh(d, "checkout", "-q", "dev")
        apply(d, c["base"])
        sh(d, "add", "-A")
        sh(d, "commit", "-q", "-m", "base change")
        sh(d, "checkout", "-q", "work")
        sh(d, "merge", "-q", "--ff-only", "dev")
    outs = []
    for step in c.get("runs", [{}]):
        for cmd in step.get("git_before", []):
            sh(d, *[a.replace("{template}", str(template)) for a in cmd])
        apply(d, step.get("edits", []))
        if step.get("commit"):
            sh(d, "add", "-A")
            sh(d, "commit", "-q", "-m", "work change")
        for cmd in step.get("git", []):
            sh(d, *[a.replace("{template}", str(template)) for a in cmd])
        args = step.get("script", c["script"])
        outs.append(run_bounded([sys.executable, "-I", str(d / "scripts" / args[0]), *args[1:]],
                                   cwd=d / step.get("cwd", "."), text=True,
                                   input=step.get("stdin"), env=dict(ENV, **c.get("env", {})),
                                   timeout=60))
    shutil.rmtree(d, ignore_errors=True)
    return c["expect"](outs)


def fails(o):
    """The check reports the failure itself: a non-zero exit without a Python traceback."""
    return o[-1].returncode != 0 and "Traceback (most recent call last)" not in o[-1].stderr
def passes(o): return o[-1].returncode == 0
def clean(name): return lambda o: passes(o) and SUCCESS[name] in o[-1].stdout
def fails_with(text): return lambda o: fails(o) and text in o[-1].stdout + o[-1].stderr
def reminder(o):
    return (passes(o) and "check-upkeep: reminder:" in o[-1].stdout
            and "none due" not in o[-1].stdout
            and "; schedule maintenance separately" in o[-1].stdout)
def is_block(p, text=""):
    """The hook keeps the session working: Stop feedback through additionalContext."""
    try:
        out = json.loads(p.stdout)
    except json.JSONDecodeError:
        return False
    spec = out.get("hookSpecificOutput", {})
    return (p.returncode == 0 and "decision" not in out and spec.get("hookEventName") == "Stop"
            and text in spec.get("additionalContext", ""))
def is_error(p, text=""):
    """The hook reports its own crash: one JSON decision that blocks, nothing else on stdout."""
    try:
        out = json.loads(p.stdout)
    except json.JSONDecodeError:
        return False
    return p.returncode == 0 and out.get("decision") == "block" and text in out.get("reason", "")
def context(p): return json.loads(p.stdout)["hookSpecificOutput"]["additionalContext"]
def is_message(p): return p.returncode == 0 and '"systemMessage"' in p.stdout and '"decision"' not in p.stdout
def is_silent(p): return p.returncode == 0 and p.stdout.strip() == ""


HOOK = json.dumps({"stop_hook_active": False})
CONTINUING = json.dumps({"stop_hook_active": True})
CHECK_EXECUTION_PROBE = '''import contextlib, io, pathlib, runpy, subprocess, sys
mode = sys.argv[1]
path = str(pathlib.Path(__file__).with_name("check"))
sys.argv = [path]
def invoke():
    report = io.StringIO()
    try:
        with contextlib.redirect_stdout(report):
            runpy.run_path(path, run_name="__main__")
    except SystemExit as exit:
        return exit.code, report.getvalue()
    return 0, report.getvalue()
if mode == "timeout":
    duration = 44.5
    def simulated(command, *, capture_output=False, text=False, timeout=None):
        if timeout is not None and duration > timeout:
            raise subprocess.TimeoutExpired(command, timeout)
        output = "fixture ok" if text else b"fixture ok"
        empty = "" if text else b""
        return subprocess.CompletedProcess(command, 0, output if capture_output else None,
                                           empty if capture_output else None)
    subprocess.run = simulated
    code, report = invoke()
    assert code == 0 and "[ok]" in report, "an operation below the 45-second budget must complete"
    duration = 45.5
    code, report = invoke()
    assert code != 0 and "unavailable: check timed out" in report, "an operation above the 45-second budget must be unavailable"
else:
    def missing(command, *, capture_output=False, text=False, timeout=None):
        raise FileNotFoundError("fixture executable unavailable")
    subprocess.run = missing
    code, report = invoke()
    assert code != 0 and "unavailable: fixture executable unavailable" in report
print("execution probe passed")
'''
COMMIT_PREFIX_PROBE = '''import hashlib, os, pathlib, subprocess, sys
root = pathlib.Path(__file__).resolve().parent.parent
commit = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=root, text=True).strip()
prefix = commit[:4]
for number in range(2000000):
    payload = f"collision-{number}".encode()
    header = b"blob " + str(len(payload)).encode() + bytes([0])
    if hashlib.sha1(header + payload).hexdigest().startswith(prefix):
        break
else:
    raise AssertionError("could not construct the commit/blob prefix collision")
subprocess.run(["git", "hash-object", "-w", "--stdin"], cwd=root,
               input=payload, capture_output=True, check=True)
result = subprocess.run([sys.executable, str(root / "scripts/check-risk")], cwd=root,
                        env=dict(os.environ, SLUMPY_CHECK_BASE=prefix),
                        capture_output=True, text=True)
assert result.returncode == 0, result.stdout + result.stderr
print("commit prefix probe passed")
'''
ADR_NEW = ("docs/decisions/0099-test.md", "# ADR-0099\n", "write")
