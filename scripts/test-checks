    ("check-risk", "            if not example or not regex.search(example):", "            if False:", "rule examples not validated"),
    ("check-lessons", " and (today - added).days > GRACE_DAYS", "", "grace period removed"),
    ("check-lessons", "    if missing:", "    if False:", "missing fields accepted"),
    ("check-lessons", 'text.split("## Entries", 1)[1])[1:]', 'text.split("## Entries", 1)[1])[2:]', "first lesson skipped"),
    ("check-lessons", '.strip().lower()', ".strip()", "guard case-sensitive"),
    ("check-layers", 'problems += scan(platform + [ROOT / "CLAUDE.md"], RESTATE, "restates a core rule")', "pass", "restating scan off"),
    ("check-layers", 'problems += scan(core, CYRILLIC, "non-English text", skip_paths=True)', "pass", "language scan off"),
    ("check-layers", '            problems.append(f"core file not named in core-process.md: {f.relative_to(ROOT)}")', "            pass", "unnamed core file accepted"),
    ("check-pointers", "if not any(s.startswith(key) for c in candidates for s in sections(c)):", "if False:", "pointers never checked"),
    ("check-pointers", '            if "/" in name:', "            if False:", "path pointers resolved by file name"),
    ("check-pointers", 'print(f"{f}:{n}: `{name}` does not exist")\n                    status = 1', "pass", "missing path accepted"),
    ("check-pointers", "dict.fromkeys((os.path.normpath(name), here))", "dict.fromkeys((os.path.normpath(name),))", "path relative to the pointing file not resolved"),
    ("check-pointers", "if (ROOT / p).is_file()]", "if p in files]", "untracked target reported missing"),
    ("check-layers", "    if f not in core and f not in platform:", "    if False:", "rule file in no layer accepted"),
    ("check-layers", '.claude/rules").rglob("*.md")', '.claude/rules").glob("*.md")', "rule files in subfolders not checked"),
    ("check-upkeep", "    elif (today - done).days > int(interval.group(1)):", "    elif False:", "due task accepted"),
    ("check-upkeep", "> int(interval.group(1))", ">= int(interval.group(1))", "task due a day early"),
    ("check-upkeep", "    elif done > today:", "    elif False:", "future date accepted"),
    ("check-upkeep", "rows = table[2:]", "rows = table[3:]", "first task skipped"),
    ("check-upkeep", 'problems = [] if rows else ["the Upkeep table has no tasks"]', "problems = []", "empty table accepted"),
    ("check-upkeep", "if len(table) < 2 or not SEPARATOR.fullmatch(table[1]):", "if len(table) < 2:", "table without a header row accepted"),
    ("check-upkeep", '    if every == "on event":\n        continue\n', "", "event task read as dated"),
    ("check-upkeep", '.split("\\n## ", 1)[0]', "", "rows after the section read as tasks"),
    ("check-pointers", " and (ROOT / f).is_file()]", "]", "deleted file crashes the scan"),
    ("check-pointers", 'FROZEN = ("AGENTS.md", ".agents/", ".codex/", ".githooks/", "evals/results/")', 'FROZEN = ("AGENTS.md",)', "frozen files scanned"),
]


def rule_lines():
    lines = (ROOT / "scripts/risk-paths").read_text(encoding="utf-8").splitlines()
    return sum(1 for l in lines if l.strip() and not l.lstrip().startswith("#"))


def all_cases():
    p = subprocess.run([sys.executable, "-I", str(ROOT / "scripts/check-risk"), "--rules"],
                       cwd=ROOT, capture_output=True, text=True)
    if p.returncode != 0:
        return None, [f"check-risk --rules failed: {(p.stdout + p.stderr).strip()}"]
    rules = json.loads(p.stdout)
    if len(rules) != rule_lines():
        return None, [f"check-risk --rules returned {len(rules)} rules for {rule_lines()} rule lines"]
    return STATIC + rule_cases(rules) + check_cases(), []


def run_cases():
    cases, failures = all_cases()
    if cases is None:
        return 0, failures
    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        template = make_template(tmp)
        def one_case(item):
            n, (desc, c) = item
            try:
                return None if run_case(template, tmp, n, c) else desc
            except Exception as e:  # a broken case is a failure, never a pass
                return f"{desc} (case error: {e})"
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
            failures = [r for r in pool.map(one_case, enumerate(cases)) if r]
    return len(cases), failures


def run_copy(mutant=None):
    with tempfile.TemporaryDirectory() as tmp:
        d = pathlib.Path(tmp) / "copy"
        copy_files(ROOT, d)
        if mutant:
            script, old, new, label = mutant
            f = d / "scripts" / script
            s = f.read_text(encoding="utf-8")
            if s.count(old) != 1:
                return f"stale mutant (text found {s.count(old)} times): {label}"
            f.write_text(s.replace(old, new), encoding="utf-8")
        p = subprocess.run([sys.executable, "-I", str(d / "scripts" / "test-checks")], cwd=d,
                           capture_output=True, text=True, env=ENV)
        if mutant is None:
            return None if p.returncode == 0 else "baseline fails; mutants not measured:\n" + p.stdout
        return None if p.returncode != 0 else f"surviving mutant: {mutant[3]} ({mutant[0]})"


def main():
    if "--mutants" in sys.argv:
        baseline = run_copy()
        if baseline:
            print(baseline)
            return 1
        with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
            problems = [r for r in pool.map(run_copy, MUTANTS) if r]
        if problems:
            print("\n".join(problems))
            print(f"test-checks: {len(problems)} of {len(MUTANTS)} mutants survive or are stale")
            return 1
        print(f"test-checks: all {len(MUTANTS)} mutants killed")
        return 0
    total, failures = run_cases()
    if failures:
        print("\n".join(failures))
        print(f"test-checks: {len(failures)} of {total or '?'} cases failed")
        return 1
    print(f"test-checks: {total} cases pass")
    return 0


sys.exit(main())
