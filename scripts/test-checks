#!/usr/bin/env python3
"""Self-test of the checks, on throwaway git copies of the agent-system files; never touches the
repository.

Cases: each planted violation fails its check, each valid change passes, an input a check cannot
read fails it, and every skip path has a case whose skipped input holds a violation. Cases are
also built from data: one per rule in scripts/risk-paths (`check-risk --rules`, whose count is
checked against the rule lines counted here) and one per entry of CHECKS in scripts/check, each
with a planted failure, so a rule or check without a working case fails the self-test. Add a case
with every new skip path or input.

--mutants: runs the unmodified self-test first (a failing baseline fails the run), then applies
each mutant in MUTANTS to a copy of the scripts; the self-test must fail on each. A surviving
mutant is logic no case observes; a mutant whose text no longer occurs exactly once is stale and
fails the run. Run it after every change to scripts/ (on demand: it takes minutes).
"""
import ast, concurrent.futures, datetime, json, os, pathlib, re, shutil, subprocess, sys, tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
COPY = ["CLAUDE.md", "README.md", "backlog.md", ".claude", "docs", "work", "scripts"]
GIT = ["git", "-c", "user.name=test", "-c", "user.email=test@example.invalid",
       "-c", "commit.gpgsign=false"]
ENV = dict(os.environ, SLUMPY_IN_TEST_CHECKS="1")
TODAY = datetime.date.today().isoformat()
def DAYS_AGO(n): return (datetime.date.today() - datetime.timedelta(days=n)).isoformat()
LATEST = datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=14))).date()  # today in UTC+14
LESSON = ("\n### {title}\n\n- **Symptom:** x\n- **Cause:** y\n- **Now guarded by:** {guard}\n"
          "- **Stale when:** z\n- **Added:** {added}\n")


def sh(d, *cmd):
    subprocess.run(GIT + list(cmd), cwd=d, check=True, capture_output=True)


def copy_files(src_root, dst):
    dst.mkdir(parents=True)
    for name in COPY:
        src = src_root / name
        if src.is_dir():
            shutil.copytree(src, dst / name, ignore=shutil.ignore_patterns("__pycache__"))
        elif src.exists():
            shutil.copy2(src, dst / name)


def make_template(tmp):
    t = tmp / "template"
    copy_files(ROOT, t)
    sh(t, "init", "-q", "-b", "dev")
    sh(t, "add", "-A")
    sh(t, "commit", "-q", "-m", "base")
    sh(t, "checkout", "-q", "-b", "work")
    return t


def apply(d, edits):
    for path, text, mode in edits:
        f = d / path
        if mode == "delete":
            shutil.rmtree(f) if f.is_dir() else f.unlink()
            continue
        f.parent.mkdir(parents=True, exist_ok=True)
        if mode == "append":
            f.write_text(f.read_text(encoding="utf-8") + text, encoding="utf-8")
        elif mode == "prepend-entry":  # insert as the first lesson entry
            s = f.read_text(encoding="utf-8")
            f.write_text(s.replace("## Entries\n", "## Entries\n" + text, 1), encoding="utf-8")
        elif mode == "replace":
            old, new = text
            s = f.read_text(encoding="utf-8")
            assert old in s, f"'{old}' not in {path}"
            f.write_text(s.replace(old, new, 1), encoding="utf-8")
        else:
            f.write_text(text, encoding="utf-8")


def run_case(template, tmp, n, c):
    d = tmp / f"case{n}"
    shutil.copytree(template, d)
    if c.get("base"):                       # committed on dev before the work branch
        sh(d, "checkout", "-q", "dev")
        apply(d, c["base"])
        sh(d, "add", "-A")
        sh(d, "commit", "-q", "-m", "base change")
        sh(d, "checkout", "-q", "work")
        sh(d, "merge", "-q", "--ff-only", "dev")
    outs = []
    for step in c.get("runs", [{}]):
        for cmd in step.get("git_before", []):
            sh(d, *[a.replace("{template}", str(template)) for a in cmd])
        apply(d, step.get("edits", []))
        if step.get("commit"):
            sh(d, "add", "-A")
            sh(d, "commit", "-q", "-m", "work change")
        for cmd in step.get("git", []):
            sh(d, *[a.replace("{template}", str(template)) for a in cmd])
        args = step.get("script", c["script"])
        outs.append(subprocess.run([sys.executable, "-I", str(d / "scripts" / args[0]), *args[1:]],
                                   cwd=d, capture_output=True, text=True,
                                   input=step.get("stdin"), env=ENV, timeout=60))
    shutil.rmtree(d, ignore_errors=True)
    return c["expect"](outs)


def fails(o):
    """The check reports the failure itself: a non-zero exit without a Python traceback."""
    return o[-1].returncode != 0 and "Traceback (most recent call last)" not in o[-1].stderr
def passes(o): return o[-1].returncode == 0
def clean(name): return lambda o: passes(o) and SUCCESS[name] in o[-1].stdout
def fails_with(text): return lambda o: fails(o) and text in o[-1].stdout + o[-1].stderr
def is_block(p, text=""):
    """The hook keeps the session working: Stop feedback through additionalContext."""
    try:
        out = json.loads(p.stdout)
    except json.JSONDecodeError:
        return False
    spec = out.get("hookSpecificOutput", {})
    return (p.returncode == 0 and "decision" not in out and spec.get("hookEventName") == "Stop"
            and text in spec.get("additionalContext", ""))
def is_message(p): return p.returncode == 0 and '"systemMessage"' in p.stdout and '"decision"' not in p.stdout
def is_silent(p): return p.returncode == 0 and p.stdout.strip() == ""


HOOK = json.dumps({"stop_hook_active": False})
CONTINUING = json.dumps({"stop_hook_active": True})
ADR_NEW = ("docs/decisions/0099-test.md", "# ADR-0099\n", "write")
PKG = ("Package.swift", "// swift-tools-version: 6.0\n", "write")
KEYCHAIN = ("App/Store.swift", "let s = SecItemAdd(q, nil)\n", "write")
CORE_BAD = (".claude/rules/core-process.md", "\nSlumpy uses iOS 18.\n", "append")
POINTER_BAD = (".claude/rules/core-process.md", ("## Risk tiers", "## Risk levels"), "replace")
OVERDUE = ("docs/lessons.md", LESSON.format(title="Old trap", guard="this entry only.", added="2000-01-01"), "append")
UPKEEP = "docs/agent-system.md"
UPKEEP_HEAD = "| Task | Every | Last done | How |\n|---|---|---|---|\n"
def upkeep_row(row): return (UPKEEP, (UPKEEP_HEAD, UPKEEP_HEAD + row + "\n"), "replace")
UPKEEP_DUE = upkeep_row("| Old task | 30 days | 2000-01-01 | x |")
def upkeep_doc(body): return (UPKEEP, "# Agent system\n\n## Upkeep\n\n" + body + "\n## Mechanism ledger\n\n| # | x |\n|---|---|\n| 1 | y |\n", "write")
T1_LINE = "- T1 because the test needs it.\n"
SEC_LINE = "- Security pass: clean, reviewer code round 1.\n"
PLAN = "work/feature/plan.md"

# The line each check prints when it passes, and only then.
SUCCESS = {"check-layers": "core files clean", "check-pointers": "all section pointers resolve",
           "check-risk": "evidence present where needed", "check-lessons": "none overdue",
           "check-upkeep": "none due"}
def lines_of(path): return len((ROOT / path).read_text(encoding="utf-8").splitlines())
# A failure each check must report, for the data-driven cases over CHECKS, and the detail it prints.
PLANT_TEXT = {"check-layers": f"core-process.md:{lines_of('.claude/rules/core-process.md') + 2}: platform or project term: Slumpy uses iOS 18.",
              "check-pointers": "has no section 'Risk tiers'", "check-risk": "App/Store.swift",
              "check-lessons": "lesson 'Old trap'", "check-upkeep": "upkeep 'Old task' is due"}
PLANT = {"check-layers": [CORE_BAD], "check-pointers": [POINTER_BAD], "check-risk": [KEYCHAIN],
         "check-lessons": [OVERDUE], "check-upkeep": [UPKEEP_DUE]}


def one(edits=(), commit=False, git=(), stdin=None, git_before=()):
    return [dict(edits=list(edits), commit=commit, git=list(git), stdin=stdin, git_before=list(git_before))]


def example_path(glob):
    return glob.replace("**/", "x/").replace("**", "a").replace("*", "a")


def rule_cases(rules):
    cases = []
    for r in rules:
        cat, n = r["category"], r["line"]
        kind = cat.removesuffix("-text")
        if cat.endswith("-text"):
            files = [(f"App/Rule{n}.swift", r["example"] + "\n", "write")]
        else:
            files = [(example_path(r["pattern"]), "x\n", "write")]
            if r["pattern"].startswith("**/"):
                files_root = [(example_path(r["pattern"][3:]), "x\n", "write")]
            else:
                files_root = None
        other = SEC_LINE if kind == "t2" else T1_LINE      # evidence for the other kind only
        own = T1_LINE if kind == "t2" else SEC_LINE
        variants = [("", files)]
        if not cat.endswith("-text") and files_root:
            variants.append((" at the root", files_root))
        for label, fs in variants:
            cases.append((f"risk-paths:{n} {cat} {r['pattern']}{label} without its evidence fails",
                          dict(runs=one(fs + [(PLAN, other, "write")]), script=["check-risk"], expect=fails)))
            cases.append((f"risk-paths:{n} {cat} {r['pattern']}{label} with its evidence passes",
                          dict(runs=one(fs + [(PLAN, other + own, "write")]), script=["check-risk"], expect=passes)))
    return cases


def check_cases():
    src = (ROOT / "scripts/check").read_text(encoding="utf-8")
    checks = next(ast.literal_eval(node.value) for node in ast.walk(ast.parse(src))
                  if isinstance(node, ast.Assign) and getattr(node.targets[0], "id", "") == "CHECKS")
    cases = [("every check in scripts/check has a planted failure, its detail, and its success line here",
              dict(script=["check-lessons"], expect=lambda o, c=checks: set(c) == set(PLANT)
                   == set(PLANT_TEXT) == set(SUCCESS) and all(PLANT[k] for k in c))),
             ("scripts/check passes a clean copy and says what it did not run",
              dict(script=["check"], expect=lambda o, c=checks: passes(o)
                   and all(f"[ok] {k}: " in o[-1].stdout and SUCCESS[k] in o[-1].stdout for k in c)
                   and "[not run] build, tests, lint" in o[-1].stdout
                   and "[not run] test-checks" in o[-1].stdout))]
    for name in checks:
        plant = PLANT.get(name)
        if not plant:
            continue
        cases.append((f"{name} reports its planted failure and not its success line",
                      dict(runs=one(plant), script=[name], expect=lambda o, n=name: fails_with(PLANT_TEXT[n])(o) and SUCCESS[n] not in o[-1].stdout)))
        cases.append((f"scripts/check reports a failure of {name}",
                      dict(runs=one(plant), script=["check"], expect=lambda o, n=name: fails(o) and f"[FAIL] {n}" in o[-1].stdout and f"\n{n}:\n" in o[-1].stdout and PLANT_TEXT[n] in o[-1].stdout)))
        cases.append((f"the hook blocks on a failure of {name}",
                      dict(runs=one(plant, stdin=HOOK), script=["check", "--hook"], expect=lambda o, n=name: is_block(o[-1], f"{n}:"))))
    return cases


