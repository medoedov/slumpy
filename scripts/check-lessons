#!/usr/bin/env python3
"""Fails when docs/lessons.md has an entry with a missing field, or an entry guarded by
"this entry only" for longer than the grace period: a lesson becomes a test, lint rule, check, or
skill, or it is removed. Any error exits non-zero.

An age counts from today in UTC-12, so it does not depend on the machine's time zone. SLUMPY_NOW
(an ISO 8601 instant with its offset) sets the clock, for the self-test."""
import datetime, os, pathlib, re, sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
GRACE_DAYS = 30
FIELDS = ("Symptom", "Cause", "Now guarded by", "Stale when", "Added")

text = (ROOT / "docs/lessons.md").read_text(encoding="utf-8")
entries = re.split(r"(?m)^### ", text.split("## Entries", 1)[1])[1:]
now = (datetime.datetime.fromisoformat(os.environ["SLUMPY_NOW"]) if os.environ.get("SLUMPY_NOW")
       else datetime.datetime.now(datetime.timezone.utc))
earliest = now.astimezone(datetime.timezone(datetime.timedelta(hours=-12))).date()
problems = []
for entry in entries:
    title = entry.splitlines()[0].strip()
    values = {f: re.search(rf"\*\*{re.escape(f)}:\*\*\s*(.+)", entry) for f in FIELDS}
    missing = [f for f, m in values.items() if not m]
    if missing:
        problems.append(f"lesson '{title}': missing {', '.join(missing)}")
        continue
    date = re.match(r"(\d{4})-(\d{2})-(\d{2})\b", values["Added"].group(1))
    try:
        added = datetime.date(*map(int, date.groups())) if date else None
    except ValueError:  # a date that does not exist
        added = None
    if added is None:
        problems.append(f"lesson '{title}': Added must start with a date, YYYY-MM-DD")
        continue
    guard = values["Now guarded by"].group(1).lower()
    if guard.startswith("this entry only") and (earliest - added).days > GRACE_DAYS:
        problems.append(f"lesson '{title}': guarded by this entry only since {added}; "
                        "turn it into a test, lint rule, check, or skill, or remove it")

if problems:
    print("\n".join(problems))
    sys.exit(1)
print(f"check-lessons: {len(entries)} entries, none overdue")
