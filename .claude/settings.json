{
  "permissions": {
    "allow": [
      "Bash(xcodebuild *)",
      "Bash(xcrun simctl *)",
      "Bash(xcrun xccov *)",
      "Bash(swift build *)",
      "Bash(swift test *)",
      "Bash(scripts/check)",
      "Bash(scripts/check *)",
      "Bash(scripts/check-*)",
      "Bash(scripts/test-checks)",
      "Bash(python scripts/check)",
      "Bash(python scripts/test-checks)",
      "Bash(python scripts/test-checks --mutants)",
      "Bash(python3 scripts/check)",
      "Bash(python3 scripts/test-checks)",
      "Bash(python3 scripts/test-checks --mutants)"
    ],
    "ask": [
      "Bash(xcodebuild *archive*)",
      "Bash(xcodebuild *-allowProvisioningUpdates*)",
      "mcp__github__merge_pull_request",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push * origin)",
      "Bash(git push * HEAD)",
      "Bash(git push * HEAD *)",
      "Edit(/.githooks/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$OS\" = Windows_NT ]; then python -I \"$CLAUDE_PROJECT_DIR\"/scripts/check --hook; else python3 -I \"$CLAUDE_PROJECT_DIR\"/scripts/check --hook; fi",
            "timeout": 360
          }
        ]
      }
    ]
  }
}
